# Backend REST API endpoint URL (Server-side & Next.js rewrites)
API_BACKEND_URL="https://apimalikseed.syscomatic.cloud/api/v1"

# Canonical Public Site URL (Used for SEO, Robots.txt, Sitemap generation)
NEXT_PUBLIC_SITE_URL="https://malik-seed-website.vercel.app"

# Secret Token for On-Demand Cache Revalidation API (/api/revalidate)
# Used via 'x-revalidate-secret' header or request body secret payload
REVALIDATE_SECRET="malik-seed-revalidate-secret"

# Default Cache Revalidation TTL in Seconds
DEFAULT_REVALIDATE_SECONDS="15"

# Optional: Direct Public API Base URL (if bypassing the Next.js API proxy)
NEXT_PUBLIC_API_BASE_URL=""

# Optional: Vercel OIDC Deployment Token (for Vercel CLI / deployment pipelines)
VERCEL_OIDC_TOKEN=""
